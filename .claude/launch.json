{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "viewer",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
