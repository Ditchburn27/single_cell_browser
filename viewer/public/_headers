/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.brain-map.org; connect-src 'self' https://api.brain-map.org; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
